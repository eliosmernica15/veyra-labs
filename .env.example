# Veyra Labs — Development Configuration Example
# Rename or copy to .env and fill with real values.

# Backend
VEYRA_BACKEND_URL=http://localhost:8000
VEYRA_API_KEY=local-dev-key

# Model settings (Phase 1 smoke-test defaults)
VEYRA_MODEL_DIM=128
VEYRA_MODEL_LAYERS=4
VEYRA_MODEL_HEADS=4
VEYRA_MODEL_CONTEXT=128
VEYRA_MODEL_VOCAB_SIZE=4096
VEYRA_MODEL_PARAMS_TARGET=2097152  # ~2M

# Paths
VEYRA_CHECKPOINT_DIR=./checkpoints
VEYRA_DATASET_RAW=./datasets/raw
VEYRA_DATASET_PROCESSED=./datasets/processed
VEYRA_RUNS_DIR=./runs

# Features
VEYRA_FEATURE_TRAINING=true
VEYRA_FEATURE_INFERENCE=true
VEYRA_FEATURE_EVALUATION=true

# Names (provisional — configurable)
VEYRA_COMPANY_NAME=Veyra Labs
VEYRA_PLATFORM_NAME=Veyra AI
VEYRA_STUDIO_NAME=Veyra Studio
VEYRA_CLI_NAME=veyra
VEYRA_DEFAULT_MODEL=Veyra Prime
VEYRA_CODING_MODEL=Veyra Code
VEYRA_IMAGE_MODEL=Veyra Vision
VEYRA_VIDEO_MODEL=Veyra Motion
VEYRA_AUDIO_MODEL=Veyra Voice
VEYRA_RESEARCH_AGENT=Veyra Research
